<UserControl x:Class="StationApp.UI.Views.Settings.IncomingSeedVehicleConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/StationApp.UI;component/Themes/AppTheme.xaml"/>
                <ResourceDictionary Source="/StationApp.UI;component/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/StationApp.UI;component/Styles/InputStyles.xaml"/>
                <ResourceDictionary Source="/StationApp.UI;component/Styles/BasePageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
                <Setter Property="Margin" Value="0,4,0,2"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E8EFF7" Margin="12" Padding="16" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Kh&#x00E1;ch h&#x00E0;ng" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchCustomerKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Margin="0,0,16,8"/>

                    <TextBlock Grid.Column="2" Text="S&#x1EA3;n ph&#x1EA9;m" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Column="3"
                             Text="{Binding SearchProductKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Margin="0,0,16,8"/>

                    <Button Grid.Column="4" Command="{Binding SearchCommand}" Style="{StaticResource UtilityButtonStyle}" Height="32" VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="T&#x00CC;M KI&#x1EBE;M" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <Separator Grid.Row="1" Background="#CCCCCC" Margin="0,0,0,12"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Lo&#x1EA1;i" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox Grid.Column="1" Text="H&#x00E0;ng nh&#x1EAD;p" IsReadOnly="True" Style="{StaticResource StandardTextBoxStyle}" Margin="0,0,16,8"/>

                    <TextBlock Grid.Column="2" Text="Kh&#x00E1;ch h&#x00E0;ng *" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding CustomerOptions}"
                              DisplayMemberPath="DisplayText"
                              TextSearch.TextPath="DisplayText"
                              SelectedItem="{Binding SelectedCustomerOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource StandardComboBoxStyle}"
                              Margin="0,0,16,8"/>

                    <TextBlock Grid.Column="4" Text="S&#x1EA3;n ph&#x1EA9;m *" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox Grid.Column="5"
                              ItemsSource="{Binding ProductOptions}"
                              DisplayMemberPath="DisplayText"
                              TextSearch.TextPath="DisplayText"
                              SelectedItem="{Binding SelectedProductOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource StandardComboBoxStyle}"
                              Margin="0,0,16,8"/>

                    <CheckBox Grid.Column="6"
                              Content="Ho&#x1EA1;t &#x0111;&#x1ED9;ng"
                              IsChecked="{Binding EditIsActive}"
                              Style="{StaticResource StandardCheckBoxStyle}"
                              VerticalAlignment="Center"
                              Margin="0,0,0,8"/>
                </Grid>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Command="{Binding ResetFormCommand}" Style="{StaticResource UtilityButtonStyle}" Margin="0,0,12,0">
                        <TextBlock Text="L&#x00C0;M M&#x1EDA;I" VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,0">
                        <TextBlock Text="L&#x01AF;U" VerticalAlignment="Center"/>
                    </Button>
                    <Button Command="{Binding DeleteCommand}" Style="{StaticResource DangerButtonStyle}">
                        <TextBlock Text="X&#x00D3;A" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="12,0,12,12">
            <DataGrid ItemsSource="{Binding SeedVehicles}"
                      SelectedItem="{Binding SelectedSeedVehicle}"
                      Style="{StaticResource SystemDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource SystemDataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource SystemDataGridRowStyle}"
                      CellStyle="{StaticResource SystemDataGridCellStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Th&#x1EE9; t&#x1EF1;" Binding="{Binding SortOrder}" Width="90" ElementStyle="{StaticResource GridTextCenter}"/>
                    <DataGridTemplateColumn Header="Lo&#x1EA1;i" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="H&#x00E0;ng nh&#x1EAD;p" Style="{StaticResource GridTextCenter}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="M&#x00E3; kh&#x00E1;ch" Binding="{Binding CustomerCode}" Width="120" ElementStyle="{StaticResource GridTextCenter}"/>
                    <DataGridTextColumn Header="Kh&#x00E1;ch h&#x00E0;ng" Binding="{Binding CustomerName}" Width="338" ElementStyle="{StaticResource GridTextLeft}"/>
                    <DataGridTextColumn Header="M&#x00E3; SP" Binding="{Binding ProductCode}" Width="120" ElementStyle="{StaticResource GridTextCenter}"/>
                    <DataGridTextColumn Header="S&#x1EA3;n ph&#x1EA9;m" Binding="{Binding ProductName}" Width="260" ElementStyle="{StaticResource GridTextLeft}"/>
                    <DataGridCheckBoxColumn Header="Ho&#x1EA1;t &#x0111;&#x1ED9;ng" Binding="{Binding IsActive, Mode=OneWay}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource GridCheckBoxCenter}"/>
                    <DataGridTextColumn Header="C&#x1EAD;p nh&#x1EAD;t" Binding="{Binding UpdatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="150" ElementStyle="{StaticResource GridTextCenter}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
