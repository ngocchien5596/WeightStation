<Window x:Class="StationApp.UI.Views.Dialogs.DeleteWeight2DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="560"
        Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    <Border Background="White" CornerRadius="10" BorderBrush="#1B3263" BorderThickness="1" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1B3263" CornerRadius="9,9,0,0">
                <Grid>
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button Content="X"
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Right"
                            Margin="0,4,4,4"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18,22,16">
                    <TextBlock Text="X&#x00E1;c nh&#x1EAD;n x&#x00F3;a d&#x1EEF; li&#x1EC7;u c&#x00E2;n l&#x1EA7;n 2 c&#x1EE7;a l&#x01B0;&#x1EE3;t c&#x00E2;n n&#x00E0;y?"
                               Foreground="#1B3263"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="S&#x1ED1; l&#x01B0;&#x1EE3;t c&#x00E2;n:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SessionNo}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Bi&#x1EC3;n s&#x1ED1; xe:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VehiclePlate}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="C&#x1EAF;t l&#x1EC7;nh:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CutOrderCode, TargetNullValue='--'}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="C&#x00E2;n l&#x1EA7;n 1:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Weight1Text, TargetNullValue='--'}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="C&#x00E2;n l&#x1EA7;n 2:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Weight2Text, TargetNullValue='--'}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="TL h&#x00E0;ng:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding NetWeightText, TargetNullValue='--'}" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Background="#FFF7ED"
                            BorderBrush="#FDBA74"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,0,0,14"
                            Visibility="{Binding PrintedDocumentWarning, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="{Binding PrintedDocumentWarning}" TextWrapping="Wrap" Foreground="#9A3412"/>
                    </Border>

                    <TextBlock Text="L&#x00FD; do x&#x00F3;a (b&#x1EAF;t bu&#x1ED9;c)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource StandardTextBoxStyle}"
                             MinHeight="76"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#F3F6FA" CornerRadius="0,0,9,9" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="H&#x1EE7;y" Style="{StaticResource UtilityButtonStyle}" Margin="0,0,10,0" Command="{Binding CancelCommand}"/>
                    <Button Content="X&#x00F3;a l&#x01B0;&#x1EE3;t c&#x00E2;n l&#x1EA7;n 2" Style="{StaticResource DangerButtonStyle}" Command="{Binding ConfirmCommand}" MinWidth="160"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
