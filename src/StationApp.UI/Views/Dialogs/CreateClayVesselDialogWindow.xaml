<Window x:Class="StationApp.UI.Views.Dialogs.CreateClayVesselDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StationApp.UI.Controls"
        Title="{Binding Title}"
        Width="720"
        Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
    <Border Background="White" CornerRadius="10" BorderBrush="#1B3263" BorderThickness="1" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1B3263" CornerRadius="9,9,0,0">
                <Grid>
                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button Content="X"
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Right"
                            Margin="0,4,4,4"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,18,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="T&#x00EA;n ph&#x01B0;&#x01A1;ng ti&#x1EC7;n" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                         Margin="0,3,0,3"
                         Text="{Binding VesselName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource StandardTextBoxStyle}"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="M&#x00E3; &#x0111;&#x01A1;n v&#x1ECB;" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="SemiBold"/>
                </StackPanel>
                <controls:AutocompleteTextBox Grid.Row="1" Grid.Column="1"
                                               Margin="0,3,12,3"
                                               State="{Binding CustomerCodeInput}"
                                               TextBoxStyle="{StaticResource StandardTextBoxStyle}"/>

                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x0110;V v&#x1EAD;n chuy&#x1EC3;n" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="SemiBold"/>
                </StackPanel>
                <controls:AutocompleteTextBox Grid.Row="1" Grid.Column="3"
                                               Margin="0,3,0,3"
                                               State="{Binding CustomerNameInput}"
                                               TextBoxStyle="{StaticResource StandardTextBoxStyle}"/>

                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="M&#x00E3; h&#x00E0;ng" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="SemiBold"/>
                </StackPanel>
                <controls:AutocompleteTextBox Grid.Row="2" Grid.Column="1"
                                               Margin="0,3,12,3"
                                               State="{Binding ProductCodeInput}"
                                               TextBoxStyle="{StaticResource StandardTextBoxStyle}"/>

                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="H&#x00E0;ng h&#x00F3;a" FontWeight="SemiBold" Foreground="#334155"/>
                    <TextBlock Text=" *" Foreground="#DC2626" FontWeight="SemiBold"/>
                </StackPanel>
                <controls:AutocompleteTextBox Grid.Row="2" Grid.Column="3"
                                               Margin="0,3,0,3"
                                               State="{Binding ProductNameInput}"
                                               TextBoxStyle="{StaticResource StandardTextBoxStyle}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ghi ch&#x00FA;" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                         Margin="0,3,0,3"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource StandardTextBoxStyle}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="{Binding ValidationMessage}"
                           Foreground="#DC2626"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </Grid>

            <Border Grid.Row="2" Background="#F3F6FA" CornerRadius="0,0,9,9" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="H&#x1EE7;y" Style="{StaticResource UtilityButtonStyle}" Margin="0,0,10,0" Command="{Binding CancelCommand}"/>
                    <Button Content="L&#x01B0;u" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ConfirmCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
