<Window x:Class="StationApp.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{StaticResource MainWindow.Title}"
        Icon="/Assets/logo.jpg"
        Height="768"
        Width="1366"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource SidebarContainerStyle}" CornerRadius="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource SidebarTopBackground}" Padding="8,0">
                    <Border.Resources>
                        <SolidColorBrush x:Key="ClockBackground" Color="#10213E"/>
                        <SolidColorBrush x:Key="ClockBorderColor" Color="#1D3256"/>
                        <SolidColorBrush x:Key="ClockForeground" Color="#D7E0F0"/>
                    </Border.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  Height="34"
                                  VerticalAlignment="Center"
                                  Margin="4,0,4,0"
                                  Style="{StaticResource HeaderComboBoxStyle}"
                                  FontSize="12"
                                  FontWeight="Normal"
                                  ItemsSource="{Binding AllowedStations}"
                                  SelectedItem="{Binding SelectedStation, Mode=TwoWay}"
                                  ToolTip="{Binding CurrentStationDisplay}"
                                  Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StationName}"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="#D7E0F0"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1"
                                Command="{Binding ToggleSidebarCommand}"
                                Width="32"
                                Height="32"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="Thu gọn / Mở rộng menu"
                                Margin="4,0,4,0">
                            <Path Data="{StaticResource Lucide.Menu}"
                                  Width="14" Height="14" Stretch="Uniform"
                                  Stroke="#D7E0F0" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{StaticResource SidebarBackground}"
                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  Background="Transparent"
                                  BorderThickness="0">
                        <StackPanel Background="{StaticResource SidebarItemBackground}">
                            <Button Style="{StaticResource SidebarMenuItemStyle}"
                                    Visibility="{Binding CanViewDashboard, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Dashboard">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Lucide.Home}" Style="{StaticResource LucidePathStyle}"/>
                                    <TextBlock Text="{StaticResource MainWindow.Nav.Dashboard}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarMenuItemStyle}"
                                    Visibility="{Binding CanViewIncomingVehicles, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="IncomingVehicles">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Lucide.LogIn}" Style="{StaticResource LucidePathStyle}"/>
                                    <TextBlock Text="{StaticResource MainWindow.Nav.Incoming}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarMenuItemStyle}"
                                    Visibility="{Binding CanViewWeighing, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Weighing">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Lucide.Scale}" Style="{StaticResource LucidePathStyle}"/>
                                    <TextBlock Text="{StaticResource MainWindow.Nav.Weighing}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarMenuItemStyle}"
                                    Visibility="{Binding CanViewCrusherWeighing, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="CrusherWeighing">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Lucide.Scale}" Style="{StaticResource LucidePathStyle}"/>
                                    <TextBlock Text="Cân mỏ đá" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarMenuItemStyle}"
                                    Visibility="{Binding CanViewClayWeighing, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="ClayWeighing">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Lucide.Scale}" Style="{StaticResource LucidePathStyle}"/>
                                    <TextBlock Text="C&#xE2;n m&#x1ECF; s&#xE9;t" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarMenuItemStyle}"
                                    Visibility="{Binding CanViewExportWeighing, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="ExportWeighing">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Lucide.Globe}" Style="{StaticResource LucidePathStyle}"/>
                                    <TextBlock Text="C&#xE2;n xu&#x1EA5;t kh&#x1EA9;u" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarMenuItemStyle}"
                                    Visibility="{Binding CanViewOutgoingVehicles, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="OutgoingVehicles">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Lucide.LogOut}" Style="{StaticResource LucidePathStyle}"/>
                                    <TextBlock Text="{StaticResource MainWindow.Nav.Outgoing}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarExpandableItemStyle}"
                                    Visibility="{Binding CanViewReportsMenu, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding ToggleReportsSubmenuCommand}"
                                    CommandParameter="Reports_">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Lucide.PieChart}" Style="{StaticResource LucidePathStyle}"/>
                                        <TextBlock Text="Báo cáo" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Path DockPanel.Dock="Right"
                                          Margin="8,0,0,0"
                                          Width="10" Height="10"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource Lucide.ChevronDown}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReportsSubmenuVisible}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource Lucide.ChevronUp}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </DockPanel>
                            </Button>

                            <StackPanel Visibility="{Binding IsReportsSubmenuVisible, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewExportSummaryReport, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Reports_ExportSummary">
                                    <TextBlock Text="B&#xE1;o c&#xE1;o xu&#x1EA5;t - N&#x110;" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewExportScaleReport, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Reports_ExportScale">
                                    <TextBlock Text="B&#xE1;o c&#xE1;o xu&#x1EA5;t - XK" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewShiftProductOutputReport, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Reports_ShiftProductOutput">
                                    <TextBlock Text="B&#xE1;o c&#xE1;o s&#x1EA3;n l&#x01B0;&#x1EE3;ng theo ca" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewInboundSummaryReport, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Reports_InboundSummary">
                                    <TextBlock Text="{Binding InboundSummaryReportMenuText}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewCrusherInboundReport, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Reports_CrusherInbound">
                                    <TextBlock Text="Báo cáo cân hàng (mỏ đá)" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewClayInboundReport, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Reports_ClayInbound">
                                    <TextBlock Text="B&#xE1;o c&#xE1;o c&#xE2;n h&#xE0;ng (m&#x1ECF; s&#xE9;t)" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                            <Button Style="{StaticResource SidebarMenuItemStyle}"
                                    Visibility="{Binding CanViewTicketList, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="TicketList">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Lucide.FileText}" Style="{StaticResource LucidePathStyle}"/>
                                    <TextBlock Text="{StaticResource MainWindow.Nav.Tickets}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SidebarMenuItemStyle}"
                                    Visibility="{Binding CanViewDiagnostics, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Diagnostics">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Lucide.Activity}" Style="{StaticResource LucidePathStyle}"/>
                                    <TextBlock Text="{StaticResource MainWindow.Nav.Diagnostics}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarExpandableItemStyle}"
                                    Visibility="{Binding CanViewSettingsMenu, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding ToggleSettingsSubmenuCommand}"
                                    CommandParameter="Settings_">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Lucide.Settings}" Style="{StaticResource LucidePathStyle}"/>
                                        <TextBlock Text="{StaticResource MainWindow.Nav.Settings}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Path DockPanel.Dock="Right"
                                          Margin="8,0,0,0"
                                          Width="10" Height="10"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource Lucide.ChevronDown}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSettingsSubmenuVisible}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource Lucide.ChevronUp}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </DockPanel>
                            </Button>

                            <StackPanel Visibility="{Binding IsSettingsSubmenuVisible, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewAppUpdate, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="AppUpdate">
                                    <TextBlock Text="Cập nhật ứng dụng" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewSettingsParams, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings_Params">
                                    <TextBlock Text="{StaticResource MainWindow.Nav.SettingsParams}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewSettingsParams, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings_Camera">
                                    <TextBlock Text="{StaticResource MainWindow.Nav.SettingsCamera}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewSettingsDevice, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings_Device">
                                    <TextBlock Text="{StaticResource MainWindow.Nav.SettingsDevice}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewSettingsPrint, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings_Print">
                                    <TextBlock Text="{StaticResource MainWindow.Nav.SettingsPrint}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewSettingsVehicles, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings_Vehicles">
                                    <TextBlock Text="{StaticResource MainWindow.Nav.SettingsVehicles}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewSettingsCustomers, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings_Customers">
                                    <TextBlock Text="{StaticResource MainWindow.Nav.SettingsCustomers}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewSettingsProducts, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings_Products">
                                    <TextBlock Text="{StaticResource MainWindow.Nav.SettingsProducts}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewSettingsIncomingSeedVehicles, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings_IncomingSeedVehicles">
                                    <TextBlock Text="Xe nhập mẫu" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewSettingsSync, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings_Sync">
                                    <TextBlock Text="{StaticResource MainWindow.Nav.SettingsSync}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewSettingsExternalDatacan, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings_ExternalDatacan">
                                    <TextBlock Text="{StaticResource MainWindow.Nav.SettingsExternalDatacan}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewSettingsStations, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings_Stations">
                                    <TextBlock Text="{StaticResource MainWindow.Nav.SettingsStations}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewSettingsAccounts, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Settings_Accounts">
                                    <TextBlock Text="{StaticResource MainWindow.Nav.SettingsAccounts}" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SidebarSubmenuItemStyle}"
                                        Visibility="{Binding CanViewEditHistoryReport, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Reports_EditHistory">
                                    <TextBlock Text="Lịch sử chỉnh sửa" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource SidebarBackground}"
                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#162846">
                    <StackPanel Background="{StaticResource SidebarFooterBackground}" Margin="12,10,12,10">
                        <StackPanel Margin="4,0,4,8">
                            <TextBlock Text="{Binding CurrentUserDisplayName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource SidebarItemForeground}"/>
                            <TextBlock Text="{Binding CurrentUserRoleCode, Converter={StaticResource RoleDisplayConverter}}" FontSize="10.5" Foreground="#7E92A8" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border BorderThickness="0,1,0,1" BorderBrush="#162846" Padding="4,6,4,6" Margin="0,0,0,10">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Tỷ lệ zoom" FontSize="11" Foreground="#7E92A8" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ZoomPercentageText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SidebarItemForeground}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Button Style="{StaticResource SidebarLogoutButtonStyle}" Command="{Binding LogoutCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{StaticResource Lucide.LogOut}" Style="{StaticResource LucidePathStyle}" Margin="0,0,8,0"/>
                                <TextBlock Text="{StaticResource MainWindow.Nav.Logout}" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="{Binding AppVersionText, StringFormat='Phiên bản {0}'}"
                                   FontSize="9.5"
                                   Foreground="#62758D"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource MainContentBackground}">
            <ContentControl Content="{Binding CurrentView}" Margin="0"/>
            
            <!-- Global Clock Capsule Badge -->
            <Border Style="{StaticResource ClockBadgeStyle}" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top" 
                    Margin="0,13,20,0"
                    Panel.ZIndex="99">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE916;" 
                               FontFamily="Segoe MDL2 Assets" 
                               Foreground="{StaticResource ClockIconForeground}" 
                               FontSize="19" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding CurrentTimeDisplay}" 
                               Style="{StaticResource ClockTextStyle}" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
