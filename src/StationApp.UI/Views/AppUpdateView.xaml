<UserControl x:Class="StationApp.UI.Views.AppUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/StationApp.UI;component/Themes/AppTheme.xaml"/>
                <ResourceDictionary Source="/StationApp.UI;component/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/StationApp.UI;component/Styles/BasePageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Border Background="#FFFFFF"
                BorderBrush="#D7E3F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Width="560"
                Height="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="3"
                                  Color="#55000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="C&#x1EAC;P NH&#x1EAC;T &#x1EE8;NG D&#x1EE4;NG"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#123B6B"
                               HorizontalAlignment="Center"/>
                    <Border Height="1" Background="#E2E8F0" Margin="0,12,0,0"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,4,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="Phi&#x00EA;n b&#x1EA3;n hi&#x1EC7;n t&#x1EA1;i"
                                   Foreground="#64748B"
                                   FontSize="13"
                                   Margin="0,0,0,4"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentVersion}"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"
                                   FontSize="18"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="#E2E8F0" Margin="24,4"/>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="Phi&#x00EA;n b&#x1EA3;n m&#x1EDB;i nh&#x1EA5;t"
                                   Foreground="#64748B"
                                   FontSize="13"
                                   Margin="0,0,0,4"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding LatestVersion}"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   FontSize="18"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2"
                        CornerRadius="6"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#3B82F6"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Foreground="#334155"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Margin="0,0,0,16">
                    <TextBlock Text="Ghi ch&#x00FA; ph&#x00E1;t h&#x00E0;nh:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,6"/>
                    <Border Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Height="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <TextBlock Text="{Binding ReleaseNotes}"
                                       TextWrapping="Wrap"
                                       Foreground="#475569"
                                       FontSize="13"
                                       LineHeight="18"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,0,0,16" VerticalAlignment="Top">
                    <TextBlock Text="Shared folder ph&#x00E1;t h&#x00E0;nh:"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding SharedReleaseRoot, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Padding="10,4"
                                 BorderBrush="#CBD5E1"
                                 Background="#FFFFFF"/>

                        <Button Grid.Column="1"
                                Command="{Binding SaveConfigurationCommand}"
                                Style="{StaticResource UtilityButtonStyle}"
                                Height="36"
                                Margin="10,0,0,0"
                                Padding="18,0">
                            <TextBlock Text="L&#x01AF;U" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding ResolvedManifestPath}"
                               Margin="0,8,0,0"
                               Foreground="#64748B"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Grid Grid.Row="5" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Command="{Binding CheckForUpdatesCommand}"
                            Style="{StaticResource UtilityButtonStyle}"
                            Height="38"
                            Margin="0,0,8,0">
                        <TextBlock Text="KI&#x1EC2;M TRA C&#x1EAC;P NH&#x1EAC;T" FontWeight="SemiBold"/>
                    </Button>

                    <Button Grid.Column="1"
                            Command="{Binding UpdateCommand}"
                            Style="{StaticResource WorkflowButtonStyle}"
                            Height="38"
                            Margin="8,0,0,0">
                        <TextBlock Text="C&#x1EAC;P NH&#x1EAC;T NGAY" FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
