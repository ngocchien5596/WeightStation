<UserControl x:Class="StationApp.UI.Views.WeighingSessionEditHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/StationApp.UI;component/Themes/AppTheme.xaml"/>
                <ResourceDictionary Source="/StationApp.UI;component/Styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/StationApp.UI;component/Styles/InputStyles.xaml"/>
                <ResourceDictionary Source="/StationApp.UI;component/Styles/BasePageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ReportDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource StandardDatePickerStyle}">
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Width" Value="130"/>
                <Setter Property="Height" Value="34"/>
            </Style>
            <Style x:Key="GridTextWrapLeft" TargetType="TextBlock" BasedOn="{StaticResource GridTextLeft}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="TextTrimming" Value="None"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
            <Style x:Key="AuditHistoryDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource SystemDataGridStyle}">
                <Setter Property="RowHeight" Value="{x:Static sys:Double.NaN}"/>
            </Style>
            <Style x:Key="AuditHistoryRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource SystemDataGridRowStyle}">
                <Setter Property="MinHeight" Value="30"/>
            </Style>
            <Style x:Key="AuditHistoryCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource SystemDataGridCellStyle}">
                <Setter Property="VerticalContentAlignment" Value="Top"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBorder}">
            <TextBlock Text="{Binding Title}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" Margin="12,12,12,8" Padding="12" Background="{DynamicResource CardBrush}" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="T&#x1EEB; ng&#x00E0;y" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ReportDatePickerStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="&#x0110;&#x1EBF;n ng&#x00E0;y" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ReportDatePickerStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="H&#x00E0;nh &#x0111;&#x1ED9;ng" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox Width="220"
                              Height="34"
                              ItemsSource="{Binding ActionOptions}"
                              SelectedItem="{Binding SelectedActionOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DisplayText"
                              Style="{StaticResource StandardComboBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Bi&#x1EC3;n s&#x1ED1; xe" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Width="120"
                             Height="34"
                             Style="{StaticResource StandardTextBoxStyle}"
                             Text="{Binding SearchVehiclePlate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="S&#x1ED1; l&#x01B0;&#x1EE3;t c&#x00E2;n" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Width="140"
                             Height="34"
                             Style="{StaticResource StandardTextBoxStyle}"
                             Text="{Binding SearchSessionNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Margin="0,0,10,0">
                    <TextBlock Text="T&#x1EEB; kh&#x00F3;a" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Width="180"
                             Height="34"
                             Style="{StaticResource StandardTextBoxStyle}"
                             Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="34" Width="90" Margin="0,0,8,0">
                        <TextBlock Text="T&#x00CC;M KI&#x1EBE;M" FontWeight="SemiBold"/>
                    </Button>
                    <Button Command="{Binding ClearFiltersCommand}" Style="{StaticResource UtilityButtonStyle}" Height="34" Width="90">
                        <TextBlock Text="X&#x00D3;A L&#x1ECC;C" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="12,0,12,12" Padding="10" Background="{DynamicResource CardBrush}" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
            <Grid>
                <DataGrid ItemsSource="{Binding HistoryItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Language="vi-VN"
                          Style="{StaticResource AuditHistoryDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource SystemDataGridColumnHeaderStyle}"
                          RowStyle="{StaticResource AuditHistoryRowStyle}"
                          CellStyle="{StaticResource AuditHistoryCellStyle}"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="50" ElementStyle="{StaticResource GridTextCenter}"/>
                        <DataGridTextColumn Header="Th&#x1EDD;i gian" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="150" ElementStyle="{StaticResource GridTextCenter}"/>
                        <DataGridTextColumn Header="Ng&#x01B0;&#x1EDD;i thao t&#x00E1;c" Binding="{Binding Actor}" Width="130" ElementStyle="{StaticResource GridTextLeft}"/>
                        <DataGridTextColumn Header="H&#x00E0;nh &#x0111;&#x1ED9;ng" Binding="{Binding ActionDisplay}" Width="190" ElementStyle="{StaticResource GridTextLeft}"/>
                        <DataGridTextColumn Header="&#x0110;&#x1ED1;i t&#x01B0;&#x1EE3;ng" Binding="{Binding EntityDisplay}" Width="150" ElementStyle="{StaticResource GridTextLeft}"/>
                        <DataGridTextColumn Header="Gi&#x00E1; tr&#x1ECB; c&#x0169;" Binding="{Binding OldValueDisplay}" Width="240" ElementStyle="{StaticResource GridTextWrapLeft}"/>
                        <DataGridTextColumn Header="Gi&#x00E1; tr&#x1ECB; m&#x1EDB;i" Binding="{Binding NewValueDisplay}" Width="240" ElementStyle="{StaticResource GridTextWrapLeft}"/>
                        <DataGridTextColumn Header="L&#x00FD; do/Ghi ch&#x00FA;" Binding="{Binding Note}" Width="230" ElementStyle="{StaticResource GridTextWrapLeft}"/>
                        <DataGridTextColumn Header="Chi ti&#x1EBF;t" Binding="{Binding DetailSummary}" Width="*" MinWidth="260" ElementStyle="{StaticResource GridTextWrapLeft}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
